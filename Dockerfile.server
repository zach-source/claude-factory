# The factory server's image (specs/004-factory-server): `factory server` with the tools it runs.
# Build from this repo's root:
#   docker buildx build --platform linux/amd64 -f Dockerfile.server -t factory-server .

FROM golang:1.27-bookworm AS axcli
ARG AX_CLI_REPO=https://github.com/google/ax
ARG AX_CLI_COMMIT=v0.3.1
RUN git clone ${AX_CLI_REPO} /ax && git -C /ax checkout ${AX_CLI_COMMIT}
WORKDIR /ax
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /ax-cli ./cmd/ax

FROM oven/bun:1.3.13-debian
ARG CLAUDE_CODE_VERSION=2.1.291
ARG GH_VERSION=2.98.0
ARG BD_VERSION=1.3.0
ARG DOLT_VERSION=2.6.0
ARG KUBECTL_VERSION=v1.36.3
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git openssh-client \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz \
  | tar -xz -C /tmp && mv /tmp/gh_${GH_VERSION}_linux_amd64/bin/gh /usr/local/bin/gh && rm -rf /tmp/gh_*
RUN curl -fsSL https://github.com/steveyegge/beads/releases/download/v${BD_VERSION}/beads_${BD_VERSION}_linux_amd64.tar.gz \
  | tar -xz -C /usr/local/bin bd
RUN curl -fsSL https://github.com/dolthub/dolt/releases/download/v${DOLT_VERSION}/dolt-linux-amd64.tar.gz \
  | tar -xz -C /tmp && mv /tmp/dolt-linux-amd64/bin/dolt /usr/local/bin/dolt && rm -rf /tmp/dolt-linux-amd64
RUN curl -fsSL -o /usr/local/bin/kubectl https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl \
  && chmod +x /usr/local/bin/kubectl
# The npm package @anthropic-ai/claude-code runs node install.cjs at postinstall, and this base image has no
# node, so install the platform package. Copy the binary out of /root, which USER bun cannot read
RUN bun add -g @anthropic-ai/claude-code-linux-x64@${CLAUDE_CODE_VERSION} \
  && cp /root/.bun/install/global/node_modules/@anthropic-ai/claude-code-linux-x64/claude /usr/local/bin/claude \
  && rm -rf /root/.bun/install
COPY --from=axcli /ax-cli /usr/local/bin/ax
# ax --help exits 1, so the smoke test uses ax version
RUN bun --version && claude --version && git --version && gh --version && bd version && dolt version \
  && ax version && kubectl version --client
WORKDIR /opt/factory
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile --production
COPY bin bin
COPY src src
COPY factories factories
COPY mod mod
RUN ln -s /opt/factory/bin/factory /usr/local/bin/factory
USER bun
# claude-factory-akiq.1 adds the server verb; the build does not run it
ENTRYPOINT ["/usr/local/bin/factory", "server"]
