{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zach-source/speckit-beads/main/schemas/task-graph.schema.json",
  "title": "Spec Kit Beads Task Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "artifacts", "tasks"],
  "properties": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "summary", "acceptance_criteria", "directory"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "string", "minLength": 1},
        "directory": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0, "maximum": 4, "default": 1}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "plan"],
      "properties": {
        "spec": {"type": "string", "minLength": 1},
        "plan": {"type": "string", "minLength": 1},
        "research": {"type": "string", "minLength": 1},
        "data_model": {"type": "string", "minLength": 1},
        "quickstart": {"type": "string", "minLength": 1},
        "constitution": {"type": "string", "minLength": 1},
        "contracts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "display_id",
          "title",
          "description",
          "acceptance_criteria",
          "phase",
          "dependencies",
          "source_refs"
        ],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "display_id": {"type": "string", "pattern": "^T[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "acceptance_criteria": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "story": {"type": ["string", "null"]},
          "parallel": {"type": "boolean", "default": false},
          "priority": {"type": "integer", "minimum": 0, "maximum": 4, "default": 2},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
