# The image an AX task runs a station's worker in (docs/remote-runner.md). AX starts
# /usr/local/bin/ax-task-runner as PID 1: AX's own runner, built from source because Substrate and AX
# publish no pullable images. It mounts the workspace and runs the task's command, `factory worker serve`,
# which clones the run's branch and runs the rig's agent headless. Build from this repo's root:
#   docker buildx build --platform linux/amd64 -f Dockerfile.worker -t factory-worker .
# The `manager` target adds what the factory manager needs (herdr, dolt, the ax CLI, the mod):
#   docker buildx build --platform linux/amd64 --target manager -f Dockerfile.worker -t factory-manager .

# AX's runner, at the release the factory is built against
FROM golang:1.27-bookworm AS runner
ARG AX_COMMIT=v0.3.1
# ENV_REPLACE, if set, is a module@version that replaces github.com/agent-substrate/env (the guest server in
# the runner). Use it for an env fork with a guest fix, such as live_output for long ssh streams.
ARG ENV_REPLACE=
RUN git clone https://github.com/google/ax /ax && git -C /ax checkout ${AX_COMMIT}
WORKDIR /ax
RUN if [ -n "${ENV_REPLACE}" ]; then \
      go mod edit -replace github.com/agent-substrate/env=${ENV_REPLACE} && go mod download github.com/agent-substrate/env; \
    fi
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /ax-task-runner ./cmd/ax-task-runner

# the ax CLI, for the manager image only: its own stage, so the worker image does not build it
FROM golang:1.27-bookworm AS axcli
ARG AX_CLI_REPO=https://github.com/google/ax
ARG AX_CLI_COMMIT=v0.3.1
RUN git clone ${AX_CLI_REPO} /ax && git -C /ax checkout ${AX_CLI_COMMIT}
WORKDIR /ax
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /ax-cli ./cmd/ax

# the plugins every VM worker gets (constitution I: the same skills on every backend and runner), from the public
# marketplace at a pinned commit. harness.ts VM_PLUGINS names where they land
FROM golang:1.27-bookworm AS plugins
ARG MARKETPLACE_COMMIT=1afc7119d8b17d3ea456d0d3a364913666df18c5
RUN git clone https://github.com/zach-source/claude-marketplace /m && git -C /m checkout ${MARKETPLACE_COMMIT}

# egm: Google's Elephant-Goldfish Model plugin (Apache-2.0), for the plan station's goldfish review. Pinned to the
# commit of tag v0.1.1. Its reviewer agents are read-only
FROM golang:1.27-bookworm AS egm
ARG EGM_COMMIT=dea7761de06ce5b51c177ebb9bba0469f24af5a4
RUN git clone https://github.com/google/elephant-goldfish-model /egm && git -C /egm checkout ${EGM_COMMIT}

FROM oven/bun:1.4.4-debian AS bun

FROM node:22-bookworm-slim AS worker
ARG CLAUDE_CODE_VERSION=2.1.319
ARG CODEX_VERSION=0.160.1
ARG PI_VERSION=0.80.2
ARG CURSOR_VERSION=2026.11.05-86047df
ARG GROK_VERSION=1.0.77
ARG GH_VERSION=2.98.0
ARG GLAB_VERSION=1.99.0
ARG BD_VERSION=1.3.2
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git openssh-client python3 \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz \
  | tar -xz -C /tmp && mv /tmp/gh_${GH_VERSION}_linux_amd64/bin/gh /usr/local/bin/gh && rm -rf /tmp/gh_*
# glab is gh for a rig on GitLab (its workers use it on merge requests)
RUN mkdir /tmp/glab && curl -fsSL https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.tar.gz \
  | tar -xz -C /tmp/glab && mv /tmp/glab/bin/glab /usr/local/bin/glab && rm -rf /tmp/glab
RUN curl -fsSL https://github.com/steveyegge/beads/releases/download/v${BD_VERSION}/beads_${BD_VERSION}_linux_amd64.tar.gz \
  | tar -xz -C /usr/local/bin bd
# the agents a rig can choose (rig add --agent): claude, codex, cursor, grok or pi, each run headless by `factory worker serve`
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} @openai/codex@${CODEX_VERSION} \
    @earendil-works/pi-coding-agent@${PI_VERSION} @xai-official/grok@${GROK_VERSION} && npm cache clean --force
# grok, pinned above: GROK_DISABLE_AUTOUPDATER=1 turns off its update check, and every factory launch also passes --no-auto-update.
# It needs FACTORY_AX_GROK=1 on the laptop; its deny hook is $GROK_HOME/hooks/factory.json (worker.ts grokHome)
ENV GROK_DISABLE_AUTOUPDATER=1
# codex keeps unified_exec on under --disable and -c; only this managed pin turns it off. With it on, write_stdin
# runs a command with no PreToolUse hook (claude-factory-fzm3). codexHome refuses a launch that shows it on
RUN mkdir -p /etc/codex && printf '[features]\nunified_exec = false\n' > /etc/codex/requirements.toml \
  && chmod 0644 /etc/codex/requirements.toml
# cursor-agent, pinned: it replaces its own binary in the background unless started with --disable-auto-update, which every
# factory launch passes. It needs FACTORY_AX_CURSOR=1 on the laptop; its deny hook is ~/.cursor/hooks.json (worker.ts cursorHome)
RUN mkdir -p /opt/cursor-agent/${CURSOR_VERSION} \
  && curl -fsSL https://downloads.cursor.com/lab/${CURSOR_VERSION}/linux/x64/agent-cli-package.tar.gz \
  | tar -xz --strip-components=1 -C /opt/cursor-agent/${CURSOR_VERSION} \
  && ln -s /opt/cursor-agent/${CURSOR_VERSION}/cursor-agent /usr/local/bin/cursor-agent
# Nix, single-user and owned by root (no daemon and no build users: gVisor refuses setgroups): an agent installs
# a tool it lacks with `nix shell nixpkgs#<pkg>`, nixpkgs pinned here and fetched at build time, or enters a
# repo's own devenv.nix with `devenv shell`, whose nixpkgs devenv's cache holds. What neither cache has (a
# repo's own derivation) builds in the VM
COPY --from=nixos/nix:2.28.3 /nix /nix
ARG NIXPKGS_REV=1c89083e451e891152365b799595cf7790a43325
# Content pin, URL-encoded (%2F = /, %2B = +, %3D = =): the build fails on any other tarball. Change it with the rev:
# nix flake prefetch github:NixOS/nixpkgs/<rev> --json
ARG NIXPKGS_NARHASH=sha256-Y1CiZ4SoBUjLQyQM%2FpY%2BrS2dXD3CHLPstF0lmOc73D4%3D
RUN mkdir -p /etc/nix && printf '%s\n' \
    'experimental-features = nix-command flakes' \
    'build-users-group =' \
    'sandbox = false' \
    'max-jobs = auto' \
    'substituters = https://cache.nixos.org https://devenv.cachix.org' \
    'trusted-public-keys = cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw=' \
    > /etc/nix/nix.conf
ENV PATH=/nix/var/nix/profiles/default/bin:$PATH
# `nix-shell -p` reads NIX_PATH, which the base image points at an old go1.23 package set. Point it at the pinned
# store path through a GC root. Register the same path. Then nix does not fetch a tarball (codeload) at run time
ENV NIX_PATH=nixpkgs=/nix/var/nix/gcroots/nixpkgs-pin
RUN mkdir -p /nix/var/nix/gcroots \
  && nix flake prefetch github:NixOS/nixpkgs/${NIXPKGS_REV}?narHash=${NIXPKGS_NARHASH} --out-link /nix/var/nix/gcroots/nixpkgs-pin \
  && p=$(readlink -f /nix/var/nix/gcroots/nixpkgs-pin) \
  && test -d "$p" \
  && nix registry add --registry /etc/nix/registry.json nixpkgs "path:$p" \
  && nix profile install --profile /nix/var/nix/profiles/default nixpkgs#devenv nixpkgs#jdk21_headless nixpkgs#gitleaks nixpkgs#jq nixpkgs#postgresql \
  && devenv version && keytool -help >/dev/null 2>&1 && gitleaks version && jq --version
# serve runs as this user, not root (asWorker in src/worker.ts), which gives it Nix's store and database when the
# task starts, since Substrate shows image files as root's, so nix shell and a rig's devenv substitute as it
RUN useradd --create-home --shell /bin/bash worker
# root (an `ax ssh` shell) cannot open Nix's database once the worker owns it, since root has no DAC_OVERRIDE, so
# nix runs as the worker for root then; before that (an image build, a task without the capabilities) it runs as is
RUN mkdir -p /opt/as-worker && printf '%s\n' '#!/bin/sh' \
    'nix=/nix/var/nix/profiles/default/bin/nix' \
    '[ "$(id -u)" = 0 ] && [ "$(stat -c %U /nix/var/nix/db)" = worker ] || exec "$nix" "$@"' \
    'exec env HOME=/home/worker USER=worker setpriv --reuid=worker --regid=worker --init-groups "$nix" "$@"' \
    > /opt/as-worker/nix && chmod 755 /opt/as-worker/nix
ENV PATH=/opt/as-worker:$PATH
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=runner /ax-task-runner /usr/local/bin/ax-task-runner
# asd-ste100: Claude loads it by --plugin-dir, codex and pi get its skill (cli.ts vmClaudeFlags, worker.ts). Its
# hooks run python3
COPY --from=plugins /m/claude/plugins/asd-ste100 /opt/plugins/asd-ste100
# code-review: the review station's two-axis review (Standards and Spec), from mattpocock/skills
COPY --from=plugins /m/claude/plugins/code-review /opt/plugins/code-review
COPY --from=egm /egm/distributions/claude /opt/plugins/egm

# the factory CLI: `factory worker serve`, and report, mail and memory add, which queue in the outbox
WORKDIR /opt/factory
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile --production
COPY bin bin
COPY src src
COPY factories factories
# src imports mod (src/sidebar.ts -> mod/hooks/view), so the worker needs it too: without it `factory` fails to start
# and serve never runs. The manager's Claude also loads it as a plugin dir: join(ROOT, 'mod') in src/cli.ts
COPY mod mod
RUN ln -s /opt/factory/bin/factory /usr/local/bin/factory
# memory search's embedding model, in transformers' cache under node_modules: a VM cannot download it through the
# egress gateway (TLS fails), so without it `factory memory search` fails in every worker (claude-factory-2yvv)
RUN bun -e "await (await import('./src/memory.ts')).fetchModel()"

# workers commit as the factory; Substrate's egress gateway puts the real keys in on the way out. Root (an `ax ssh`
# shell) may read the worker's repos without git's dubious-ownership refusal
RUN git config --system user.name 'claude-factory worker' \
  && git config --system user.email 'factory-worker@users.noreply.github.com' \
  && git config --system safe.directory '*'
# the runner is PID 1 and root, and serve stays root when its task lacks the capabilities to become the worker
# user; Claude refuses to skip permissions as root outside a declared sandbox: the microVM is that sandbox
ENV IS_SANDBOX=1
ENTRYPOINT ["/usr/local/bin/ax-task-runner"]

# The manager's image: the worker image plus what the manager session needs. The manager runs as a long-lived
# AX task. ax-task-runner stays PID 1. dolt comes from the pinned nixpkgs (dolt is for bd's server mode).
# herdr is the upstream release binary, pinned by sha256. `herdr --remote` from the laptop needs a compatible
# herdr in the task, so keep HERDR_VERSION the same as the laptop's. sshd for the attach is the image's Nix openssh
FROM worker AS manager
ARG HERDR_VERSION=0.9.3
ARG HERDR_SHA256=18a8dc65f1c2fa485884344356dea1cfd911c6f06cf46fa78e193f4087f4dba7
RUN nix profile install --profile /nix/var/nix/profiles/default nixpkgs#dolt && dolt version \
  && curl -fsSL -o /usr/local/bin/herdr https://github.com/herdrdev/herdr/releases/download/v${HERDR_VERSION}/herdr-linux-x86_64 \
  && echo "${HERDR_SHA256}  /usr/local/bin/herdr" | sha256sum -c - && chmod 755 /usr/local/bin/herdr \
  && herdr --version && test -x /nix/var/nix/profiles/default/bin/sshd
COPY --from=axcli /ax-cli /usr/local/bin/ax
# the laptop-side lease code keys on this
ENV FACTORY_IN_AX=1

# the last stage is the default target: a build with no --target makes the worker image
FROM worker
